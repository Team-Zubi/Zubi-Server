APP_NAME="Zubi Server"
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# PostgreSQL + PostGIS (로컬: docker compose up -d db)
DATABASE_URL=postgresql+psycopg://zubi:zubi@localhost:5432/zubi

# 공공 API 키 (Doc/11_API_키.md) — 비어 있으면 해당 출처는 수집하지 않음
SEOUL_API_KEY=
GG_API_KEY=

# 수집기
COLLECTOR_INTERVAL_SECONDS=300
